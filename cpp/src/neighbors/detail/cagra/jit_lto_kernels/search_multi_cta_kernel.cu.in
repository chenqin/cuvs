#include <neighbors/detail/cagra/jit_lto_kernels/kernel_def.hpp>
#include <neighbors/detail/cagra/jit_lto_kernels/search_multi_cta_jit.cuh>

namespace {

using data_t         = @data_type@;
using index_t        = @index_type@;
using distance_t     = @distance_type@;
using source_index_t = @source_index_type@;
using dataset_desc_base =
  cuvs::neighbors::cagra::detail::dataset_descriptor_base_t<data_t, index_t, distance_t>;
using cagra_sample_filter_t = cuvs::neighbors::cagra::detail::cagra_sample_filter<source_index_t>;

}  // namespace

namespace cuvs::neighbors::cagra::detail::multi_cta_search {

// Neither entry point has __launch_bounds__: it would make nvJitLink ignore -maxrregcount. The
// multi-CTA planner links search_multi_cta with -maxrregcount=64 (what __launch_bounds__(1024, 1)
// allowed, so any block size up to 1024 launches) and the search_multi_cta_small entry point with
// the cap that __launch_bounds__(kSmallBlockMaxThreads, kSmallBlockMinBlocksPerSm) allowed (40
// registers), unless CUVS_CAGRA_JIT_LINK_OPTIONS_search_multi_cta (both entry points) or
// CUVS_CAGRA_JIT_LINK_OPTIONS_search_multi_cta_small sets another cap. A lower cap raises the
// resident blocks per SM (64 registers x 128 threads limit an SM to 8 blocks). The small entry
// point is also linked with 32 registers, a resident variant that select_and_run() launches when
// it runs the grid in fewer waves (see search_multi_cta_resident_variant.hpp).
extern "C" __global__ void search_multi_cta(index_t* const result_indices_ptr,
                                            distance_t* const result_distances_ptr,
                                            const dataset_desc_base* dataset_desc,
                                            const data_t* const queries_ptr,
                                            const index_t* const knn_graph,
                                            const std::uint32_t max_elements,
                                            const std::uint32_t graph_degree,
                                            const source_index_t* source_indices_ptr,
                                            const unsigned num_distilation,
                                            const uint64_t rand_xor_mask,
                                            const index_t* seed_ptr,
                                            const std::uint32_t num_seeds,
                                            const std::uint32_t visited_hash_bitlen,
                                            index_t* const traversed_hashmap_ptr,
                                            const std::uint32_t traversed_hash_bitlen,
                                            const std::uint32_t itopk_size,
                                            const std::uint32_t min_iteration,
                                            const std::uint32_t max_iteration,
                                            std::uint32_t* const num_executed_iterations,
                                            const index_t graph_size,
                                            const std::uint32_t query_id_offset,
                                            cagra_sample_filter_t filter_payload)
{
  search_kernel_jit<data_t, index_t, distance_t, source_index_t>(result_indices_ptr,
                                                                 result_distances_ptr,
                                                                 dataset_desc,
                                                                 queries_ptr,
                                                                 knn_graph,
                                                                 max_elements,
                                                                 graph_degree,
                                                                 source_indices_ptr,
                                                                 num_distilation,
                                                                 rand_xor_mask,
                                                                 seed_ptr,
                                                                 num_seeds,
                                                                 visited_hash_bitlen,
                                                                 traversed_hashmap_ptr,
                                                                 traversed_hash_bitlen,
                                                                 itopk_size,
                                                                 min_iteration,
                                                                 max_iteration,
                                                                 num_executed_iterations,
                                                                 graph_size,
                                                                 query_id_offset,
                                                                 filter_payload);
}

// Variant of search_multi_cta for thread blocks of at most kSmallBlockMaxThreads threads. Its
// default register cap (set at link time, see above) lets kSmallBlockMinBlocksPerSm thread blocks
// of that size fit on a multiprocessor; that of search_multi_cta allows one thread block of 1024
// threads. select_and_run() launches this variant when the thread block size is at most
// kSmallBlockMaxThreads and the multiprocessors hold that many thread blocks (see
// use_small_block_entry_point).
extern "C" __global__ void search_multi_cta_small(index_t* const result_indices_ptr,
                                                  distance_t* const result_distances_ptr,
                                                  const dataset_desc_base* dataset_desc,
                                                  const data_t* const queries_ptr,
                                                  const index_t* const knn_graph,
                                                  const std::uint32_t max_elements,
                                                  const std::uint32_t graph_degree,
                                                  const source_index_t* source_indices_ptr,
                                                  const unsigned num_distilation,
                                                  const uint64_t rand_xor_mask,
                                                  const index_t* seed_ptr,
                                                  const std::uint32_t num_seeds,
                                                  const std::uint32_t visited_hash_bitlen,
                                                  index_t* const traversed_hashmap_ptr,
                                                  const std::uint32_t traversed_hash_bitlen,
                                                  const std::uint32_t itopk_size,
                                                  const std::uint32_t min_iteration,
                                                  const std::uint32_t max_iteration,
                                                  std::uint32_t* const num_executed_iterations,
                                                  const index_t graph_size,
                                                  const std::uint32_t query_id_offset,
                                                  cagra_sample_filter_t filter_payload)
{
  search_kernel_jit<data_t, index_t, distance_t, source_index_t>(result_indices_ptr,
                                                                 result_distances_ptr,
                                                                 dataset_desc,
                                                                 queries_ptr,
                                                                 knn_graph,
                                                                 max_elements,
                                                                 graph_degree,
                                                                 source_indices_ptr,
                                                                 num_distilation,
                                                                 rand_xor_mask,
                                                                 seed_ptr,
                                                                 num_seeds,
                                                                 visited_hash_bitlen,
                                                                 traversed_hashmap_ptr,
                                                                 traversed_hash_bitlen,
                                                                 itopk_size,
                                                                 min_iteration,
                                                                 max_iteration,
                                                                 num_executed_iterations,
                                                                 graph_size,
                                                                 query_id_offset,
                                                                 filter_payload);
}

static_assert(
  std::is_same_v<decltype(search_multi_cta),
                 search_multi_cta_kernel_func_t<data_t, index_t, distance_t, source_index_t>>);
static_assert(
  std::is_same_v<decltype(search_multi_cta_small),
                 search_multi_cta_kernel_func_t<data_t, index_t, distance_t, source_index_t>>);

}  // namespace cuvs::neighbors::cagra::detail::multi_cta_search
